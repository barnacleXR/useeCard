# 实例的访问地址。正式部署填反向代理后的 HTTPS 地址；本机试用填 http://localhost:3090。
BASE_URL=https://card.example.com

# 可选：镜像版本，默认 latest；可固定为发布版本号，例如 1.0.0。
# USEECARD_VERSION=latest
# 可选：宿主机监听地址与端口。默认只监听本机 127.0.0.1:3090，由反向代理转发；
# 需要局域网直接访问时设为 0.0.0.0（仅建议在可信内网使用）。
# USEECARD_BIND=127.0.0.1
# USEECARD_PORT=3090

# 可选：外部通知。用 docker compose --profile notifications up -d 启动随附 Apprise 时取消注释；
# 也可填写已有 Apprise 服务的 /notify 地址。网关启用 Basic Auth 时另设 APPRISE_API_USERNAME / APPRISE_API_PASSWORD。
# APPRISE_API_URL=http://apprise:8000/notify

# 可选：单点登录（OIDC）。设置 OIDC_ISSUER 即启用，回调地址为 BASE_URL/api/auth/oidc/callback。
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=useecard
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Pocket ID

# 可选：只读 REST API 每个 Key 每分钟请求上限（默认 120）。
# CCM_API_RATE_LIMIT=120

# 可选：会话 Cookie 的 Secure 标志，默认按 BASE_URL 是否为 https 自动判断。
# COOKIE_SECURE=true

# 可选：信任的反向代理（默认本机与内网）。端口直接暴露给不可信网络时设为 false。
# TRUST_PROXY=false
