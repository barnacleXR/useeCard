BASE_URL=https://card.example.com
COOKIE_SECURE=true

# 可选：docker compose --profile notifications up -d --build
# 使用随附 Apprise 时取消下一行注释；也可填写你已有服务的 /notify 地址。
# APPRISE_API_URL=http://apprise:8000/notify
# 如已有网关启用 Basic Auth，可另设 APPRISE_API_USERNAME / APPRISE_API_PASSWORD。

# 可选：单点登录（OIDC）。设置 OIDC_ISSUER 即启用，回调地址为 BASE_URL/api/auth/oidc/callback。
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=ccm
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Pocket ID

# 可选：只读 REST API 每个 Key 每分钟请求上限（默认 120）。
# CCM_API_RATE_LIMIT=120
